# Copy this file to .env and fill in real values. Never commit the real .env.
# python-dotenv (already in requirements.txt) loads this automatically when
# job_auto_apply.py starts.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# From @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# Target job titles for the JobsDB scraper - Python list syntax, searched
# one title at a time. Example:
# JOB_APPLY=['Data Scientist','Data Analyst']
JOB_APPLY=

# Location for JobsDB's own "where" search field (matches what you'd type
# into the location box on th.jobsdb.com). Optional - leave blank to search
# all of Thailand. Example:
# JOB_WHERE='Bangkok Metropolitan Region'
JOB_WHERE=

# Your resume PDF - read by the TUI dashboard's job-detail popup to compute
# a rough keyword-overlap "fit" score against each job's JD. Not used to
# actually submit anything (JobsDB Quick Apply uses the resume already on
# file in your JobsDB profile for that).
# RESUME_PATH=/path/to/your/resume.pdf
RESUME_PATH=

# JobsDB login - required only if config.json's apply.enabled=true.
# Used to log into https://th.jobsdb.com to submit (or, in dry-run mode,
# rehearse submitting) Quick Apply applications on your behalf.
# JobsDB login is passwordless: submitting your email triggers a one-time
# code sent to your inbox, which you type into the browser window yourself.
JOBDB_EMAIL=
